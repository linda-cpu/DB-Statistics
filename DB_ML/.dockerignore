# Ignore local python caches and virtual environments
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore local build or IDE artifacts
.git/
.vscode/
.idea/

# Optional: Ignore your huge local CSV training data if you want the container 
# to download it freshly via ImportService during the first /train run.
